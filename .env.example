# HTTP Server Configuration
HTTP_PORT=8081

# Database Configuration
DB_PATH=file:./whatsapp.db?_foreign_keys=on&mode=rwc

# WhatsApp Configuration
WHATSAPP_LOG_LEVEL=INFO

# Watermill Configuration
WATERMILL_DEBUG=false
WATERMILL_TRACE=false

# Webhook Plugin Configuration
PLUGINS_WEBHOOK_URL=https://your-webhook-endpoint.com/webhook

# AWS S3 Configuration (Optional - for media file uploads)
PLUGINS_WEBHOOK_S3_ENABLED=true
PLUGINS_WEBHOOK_S3_REGION=us-east-1
PLUGINS_WEBHOOK_S3_BUCKET=your-bucket-name
PLUGINS_WEBHOOK_S3_ACCESS_KEY_ID=your-access-key-id
PLUGINS_WEBHOOK_S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: For S3-compatible services like MinIO
# PLUGINS_WEBHOOK_S3_ENDPOINT=https://s3.example.com


# S3 URL Format Style (Optional)
# Determines how S3 URLs are generated for uploaded media files
# Options: "path" (default), "subdomain", "auto"
#
# Examples:
# - path:      https://t3.storage.dev/shared-renr/whatsapp/file.jpg
# - subdomain: https://shared-renr.t3.storage.dev/whatsapp/file.jpg
# - auto:      subdomain for AWS S3, path for custom endpoints
#
# Use "subdomain" for CDN integration (CloudFlare R2, Bunny CDN)
# Use "path" for MinIO, legacy S3, or buckets with underscores
#
# Note: Subdomain style requires DNS-compatible bucket names
#       (lowercase letters, numbers, hyphens only - no underscores)
PLUGINS_WEBHOOK_S3_URL_STYLE=path

# Renr Queue Configuration
RENR_QUEUE_URL=https://api.renr.biz.id
RENR_QUEUE_USERNAME=your-username
RENR_QUEUE_PASSWORD=your-password

# Renr Queue Persistence Configuration (Optional)
# Enable/disable SQL persistence and retry logic (default: true)
RENR_QUEUE_PERSISTENCE_ENABLED=true
# Worker interval for processing pending messages (default: 5s)
RENR_QUEUE_WORKER_INTERVAL=5s
# Maximum retry delay for failed messages (default: 24h)
RENR_QUEUE_MAX_RETRY_DELAY=24h
# Maximum requests per second for queue processing (default: 25)
# Controls the rate limit for processing pending messages from the queue
RENR_QUEUE_MAX_REQUESTS_PER_SEC=25

# Renr Plugin S3 Configuration (Optional - separate from webhook plugin)
# Enable S3 uploads for Renr plugin (default: false)
RENR_PLUGIN_S3_ENABLED=true
# S3 bucket name for Renr plugin media uploads
RENR_PLUGIN_S3_BUCKET=renr-whatsapp-media
# S3 region
RENR_PLUGIN_S3_REGION=us-east-1
# S3 credentials
RENR_PLUGIN_S3_ACCESS_KEY_ID=your-access-key-id
RENR_PLUGIN_S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: For S3-compatible services like MinIO
# RENR_PLUGIN_S3_ENDPOINT=http://localhost:9000
# Optional: URL style (path/subdomain/auto) - default: path
# RENR_PLUGIN_S3_URL_STYLE=path
